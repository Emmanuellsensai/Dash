# Neon Postgres connection string (pooled), used by the Next.js app
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Neon Postgres connection string (unpooled), used by migrations
DATABASE_URL_UNPOOLED=postgres://user:pass@host/db?sslmode=require

# Optional: GitHub token to raise API rate limits (60/hr -> 5000/hr)
GITHUB_TOKEN=

# Admin password for the /admin area
ADMIN_PASSWORD=change-me

# Secret used to sign the admin session cookie (long random string)
SESSION_SECRET=change-me-to-a-long-random-string

# Google Gemini API key for advisory comment and naming notes
GEMINI_API_KEY=

# Gemini model to use, for example gemini-2.5-flash
GEMINI_MODEL=

# Max Gemini advisory calls per day across the whole app
GEMINI_DAILY_LIMIT=50

# Max attempts per (repo, day) counted against non-admin users
MAX_ATTEMPTS_PER_SUBMISSION=2
