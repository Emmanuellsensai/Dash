# Anthropic API key (set a $5 hard spend cap on this key in the console)
ANTHROPIC_API_KEY=sk-ant-...

# Neon Postgres connection string (Vercel Postgres also works)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Where CLAUDE.md and curriculum/curriculum.md live, relative to repo root.
# In production these are read from bundled files (see lib/rules.ts).
CURRICULUM_PATH=../curriculum/curriculum.md
RULES_PATH=../CLAUDE.md

# Admin password for unlimited teacher runs
ADMIN_PASSWORD=change-me

# Optional: GitHub token to raise API rate limits (60/hr -> 5000/hr)
GITHUB_TOKEN=

# Hard cost cap in US cents. Reviews refuse once cumulative spend passes this.
SPEND_CAP_CENTS=500

# Max attempts per (repo, day) counted against non-admin users
MAX_ATTEMPTS_PER_SUBMISSION=2
